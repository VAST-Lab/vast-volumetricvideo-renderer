// SPDX-License-Identifier: MIT
// WebGPU-compatible compute shader (workgroup size 256, no SM 6.0 wave intrinsics required).
#define GROUP_SIZE 256

#pragma kernel CSCalcViewData
#pragma kernel InitWebGpuRadixSort
#pragma kernel UpsweepWebGpu
#pragma kernel ScanWebGpu
#pragma kernel DownsweepWebGpu
#pragma kernel CSDecodeVideoSplats
#pragma kernel CSApply4DDelta

#include "GaussianSplatting.hlsl"
#include "WebGpuRadixSort.hlsl"
#include "UnityCG.cginc"

float4x4 _MatrixObjectToWorld;
float4x4 _MatrixWorldToObject;
float4x4 _MatrixMV;
float4x4 _MatrixP;
float4x4 _MatrixVP;
float4 _VecScreenParams;
float4 _VecWorldSpaceCameraPos;

RWStructuredBuffer<uint> _SplatSortDistances;
RWStructuredBuffer<uint> _SplatSortKeys;
uint _SplatCount;
uint _SplatOffset;
uint _WriteSortKeys;

// radix sort etc. friendly, see http://stereopsis.com/radix.html
uint FloatToSortableUint(float f)
{
    uint fu = asuint(f);
    uint mask = -((int)(fu >> 31)) | 0x80000000;
    return fu ^ mask;
}

RWStructuredBuffer<SplatViewData> _SplatViewData;

float _SplatScale;
float _SplatOpacityScale;
uint _SHOrder;
uint _SHOnly;

[numthreads(GROUP_SIZE,1,1)]
void CSCalcViewData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    SplatData splat = LoadSplatGeometry(idx);
    SplatViewData view = (SplatViewData)0;
    
    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos,1)).xyz;
    float4 centerClipPos = mul(_MatrixVP, float4(centerWorldPos, 1));
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;

    view.pos.x = asfloat(0x7f800000u); // culled unless a visible center is written below
    bool behindCam = centerClipPos.w <= 0;
    if (!behindCam)
    {
        float4 boxRot = splat.rot;
        float3 boxSize = splat.scale;

        float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);

        float3 cov3d0, cov3d1;
        CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
        float splatScale2 = splatScale * splatScale;
        cov3d0 *= splatScale2;
        cov3d1 *= splatScale2;
        float3 cov2d = CalcCovariance2D(splat.pos, cov3d0, cov3d1, _MatrixMV, _MatrixP, _VecScreenParams);
        
        float2 axis1, axis2;
        DecomposeCovariance(cov2d, axis1, axis2);

        // frustum culling:
        // quad corners are +/-2 along each axis, then
        // pixels are converted to clip space by 2 / screen size * w
        float2 extentClip = 4 * (abs(axis1) + abs(axis2)) / _VecScreenParams.xy * centerClipPos.w;
        bool outsideView = any(abs(centerClipPos.xy) > centerClipPos.w + extentClip);
        if (!outsideView)
        {
            view.pos = centerClipPos.xyz / centerClipPos.w;
            view.axis1 = f32tof16(axis1.x) | (f32tof16(axis1.y) << 16);
            view.axis2 = f32tof16(axis2.x) | (f32tof16(axis2.y) << 16);
            // load color / SH only for splats that passed frustum culling
            LoadSplatColor(idx, splat);
            float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
            float3 objViewDir = mul((float3x3)_MatrixWorldToObject, worldViewDir);
            objViewDir = normalize(objViewDir);

            half4 col;
            col.rgb = ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0);
            col.a = min(splat.opacity * opacityScale, 65000);
            view.color.x = (f32tof16(col.r) << 16) | f32tof16(col.g);
            view.color.y = (f32tof16(col.b) << 16) | f32tof16(col.a);
        }
    }
    
    uint outputIndex = _SplatOffset + idx;
    _SplatViewData[outputIndex] = view;
    if (_WriteSortKeys != 0)
    {
        float depth = -mul(_MatrixMV, float4(splat.pos, 1)).z;
        _SplatSortDistances[outputIndex] = FloatToSortableUint(depth);
        _SplatSortKeys[outputIndex] = outputIndex;
    }
}

// ----------------------------------------------------------------------------
// Video-Texture Splatting Decoder (WebGPU hardware video decode -> splat buffers)
// ----------------------------------------------------------------------------
Texture2D<float4> _SplatVideoTex;
uint _VideoGridWidth;
uint _VideoGridHeight;
float3 _BoundsMin;
float3 _BoundsMax;
float2 _ScaleMinMax;

[numthreads(GROUP_SIZE,1,1)]
void CSDecodeVideoSplats (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint gx = idx % _VideoGridWidth;
    uint gy = idx / _VideoGridWidth;

    float4 posHigh = _SplatVideoTex.Load(int3(gx, gy + _VideoGridHeight, 0));
    float4 posLow  = _SplatVideoTex.Load(int3(gx + _VideoGridWidth, gy + _VideoGridHeight, 0));
    float4 rotScl  = _SplatVideoTex.Load(int3(gx, gy, 0));
    float4 colOpa  = _SplatVideoTex.Load(int3(gx + _VideoGridWidth, gy, 0));

    float3 normPos = (floor(posHigh.rgb * 255.0 + 0.5) * 256.0 + floor(posLow.rgb * 255.0 + 0.5)) / 65535.0;
    float3 pos = lerp(_BoundsMin, _BoundsMax, normPos);

    _SplatPos.Store3(idx * 12, asuint(pos));

    float3 scale = exp(lerp(_ScaleMinMax.x, _ScaleMinMax.y, rotScl.bbb));
    float opacity = colOpa.a > 0.0 ? colOpa.a : (posLow.a > 0.0 ? posLow.a : 1.0);

    uint packedRot = EncodeOctahedralToSpzRotation(rotScl.rg);
    uint scaleXY = f32tof16(scale.x) | (f32tof16(scale.y) << 16);
    uint scaleZOp = f32tof16(scale.z) | (f32tof16(opacity) << 16);

    _SplatOther.Store3(idx * 12, uint3(packedRot, scaleXY, scaleZOp));
    _SplatColor.Store(idx * 4, PackColorRGB10E2(colOpa.rgb));
}

// ----------------------------------------------------------------------------
// GPU-side 4DGS Delta Application
// ----------------------------------------------------------------------------
ByteAddressBuffer _DeltaStream;
float _DeltaPosScale;
uint _DeltaFlags;

[numthreads(GROUP_SIZE,1,1)]
void CSApply4DDelta (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint maskBytes = (_SplatCount + 7u) >> 3;
    uint maskByteOffset = 8u + (idx >> 3);
    uint maskWord = _DeltaStream.Load(maskByteOffset & ~3u);
    uint shift = ((maskByteOffset & 3u) * 8u) + (idx & 7u);
    if (((maskWord >> shift) & 1u) == 0u)
        return;

    uint int16Offset = 8u + maskBytes;
    uint dxOffset = int16Offset + idx * 2u;
    uint dyOffset = int16Offset + (_SplatCount + idx) * 2u;
    uint dzOffset = int16Offset + (_SplatCount * 2u + idx) * 2u;

    uint rawX = (_DeltaStream.Load(dxOffset & ~3u) >> ((dxOffset & 2u) * 8u)) & 0xFFFFu;
    uint rawY = (_DeltaStream.Load(dyOffset & ~3u) >> ((dyOffset & 2u) * 8u)) & 0xFFFFu;
    uint rawZ = (_DeltaStream.Load(dzOffset & ~3u) >> ((dzOffset & 2u) * 8u)) & 0xFFFFu;

    int dx = (int)rawX; if (dx >= 32768) dx -= 65536;
    int dy = (int)rawY; if (dy >= 32768) dy -= 65536;
    int dz = (int)rawZ; if (dz >= 32768) dz -= 65536;

    float3 pos = asfloat(_SplatPos.Load3(idx * 12u));
    pos.x += dx * _DeltaPosScale;
    pos.y += dy * _DeltaPosScale;
    pos.z += dz * _DeltaPosScale;

    _SplatPos.Store3(idx * 12u, asuint(pos));
}
